{
  "name": "aquafish-root",
  "private": true,
  "scripts": {
    "minio": "docker compose up -d",
    "minio:stop": "docker compose down",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev:next",
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "db:push": "npm --prefix frontend run db:push 2>/dev/null & npm --prefix backend run db:push 2>/dev/null",
    "db:seed": "npm --prefix backend run db:seed",
    "setup": "npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
