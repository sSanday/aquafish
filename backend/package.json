{
  "name": "aquafish-backend",
  "version": "1.0.0",
  "description": "AquaPrime REST API — Express + Prisma + Neon PostgreSQL",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
