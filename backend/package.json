    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.16.5",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
